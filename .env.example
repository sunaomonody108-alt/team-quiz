# Firebase コンソール →「プロジェクトの設定」→「マイアプリ(ウェブ)」に出る値を貼る。
# このファイルを .env.local という名前でコピーして使う(.env.local は Git に上げない)。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# イベントID(通常は変更不要)
VITE_EVENT_ID=main
# ローカル開発で Emulator を使うときだけ true
VITE_USE_EMULATOR=false
