{
  "name": "team-quiz",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "emu": "firebase emulators:start --only auth,firestore --project demo-quiz",
    "emu:seed": "node scripts/seed-emulator.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run tests/unit",
    "test:emu": "firebase emulators:exec --only firestore --project demo-quiz \"vitest run tests/emulator\"",
    "test:all": "npm test && npm run test:emu"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-admin": "^14.5.1",
    "firebase-tools": "^15.37.0",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@firebase/app": "0.16.7",
    "@firebase/app-compat": "0.5.23"
  }
}
